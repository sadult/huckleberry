{
  "manifest_version": 3,
  "name": "Huckleberry \u2014 Smart Questionnaire Assistant",
  "short_name": "Huckleberry",
  "version": "0.3.1",
  "description": "Record a macro once, then let AI answer practice questionnaires for you. Ten built-in providers (Gemini, OpenAI, Claude, Groq, OpenRouter and more), stall detection with manual assist, questionnaire memory and Telegram remote control.",
  "author": "Mersad Shahidi",
  "homepage_url": "https://github.com/themersad/huckleberry",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "tabs", "scripting", "notifications", "alarms", "downloads", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Huckleberry (open side panel)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "sidebar/sidebar.html" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/selector.js", "content/executor.js", "content/recorder.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["ai/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"],
      "js": ["ai/chatgpt.js"],
      "run_at": "document_idle"
    }
  ]
}
